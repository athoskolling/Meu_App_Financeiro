# Copie para .env.local e preencha. Nunca commite valores reais.

# Conexão do app com o Postgres, via pooler do Supabase (porta 6543)
# Obrigatória. Com o Postgres local do docker-compose.yml, o formato é:
#   postgres://postgres:<senha>@127.0.0.1:5432/meu_financeiro
DATABASE_URL=
# Conexão direta usada só nas migrations (porta 5432)
DATABASE_URL_MIGRATIONS=
# URL do projeto Supabase
SUPABASE_URL=
# Chave anon (pública) do Supabase; a service_role não é usada pelo app
SUPABASE_ANON_KEY=
# E-mail do Google do dono; qualquer outra conta é recusada. Obrigatória.
# As demais variáveis são opcionais por enquanto e viram obrigatórias no cartão que as usa (ADR-0019).
OWNER_EMAIL=
# Segredo que autentica as chamadas do cron
CRON_SECRET=
# Client ID do MeuPluggy
PLUGGY_CLIENT_ID=
# Client secret do MeuPluggy
PLUGGY_CLIENT_SECRET=
